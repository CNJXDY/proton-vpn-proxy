# Proton VPN proxy configuration
PORT=3000

# Optional: relay host/port
PROTON_RELAY_HOST=relay.protonvpn.net
PROTON_RELAY_PORT=443

# Optional: upstream SOCKS/HTTP proxy for outbound
# UPSTREAM_PROXY=http://user:pass@proxy-host:port

# Optional: Proton API auth token
# PROTON_AUTH_TOKEN=your_token_here
